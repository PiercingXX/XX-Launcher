<?xml version="1.0" encoding="utf-8"?>
<!--
  xx-launcher mark: four centred bars of unequal length — the home screen is a
  centred column of app labels, so the mark is a picture of the app itself.

  Centred is the whole point. A left-aligned stack of equal bars is a hamburger
  menu; these are ragged on both sides about the centre line, which is what a
  column of words looks like and what no other glyph in the set does.

  This is the adaptive-icon FOREGROUND; the Ink tile is the background layer.
  House glyph language (BRAND-GUIDE.md §5): 108 viewport, Signal stroke, width 4,
  round caps, no fills. Inside x,y 35..73, so it clears the 66dp safe zone and
  survives any mask the launcher applies.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M42,38 L66,38"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M37,49 L71,49"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M45,60 L63,60"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <path
        android:pathData="M40,71 L68,71"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

</vector>
